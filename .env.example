NEXT_PUBLIC_API_URL=
# Nombre de la empresa en el formulario de autorización y consentimiento.
NEXT_PUBLIC_COMPANY_NAME=ApplicanTree

# FE-SEC-010 — Content Security Policy mode: enforce (default) | report-only
# CSP_MODE=enforce
# Opt-in HTTP Strict Transport Security after HTTPS inventory of all hosts
# ENABLE_HSTS=1

# MAINTENANCE_MODE=true bloquea todas las rutas (redirect a /mantenimiento) y responde 503 en /api.
# MAINTENANCE_MODE=true
